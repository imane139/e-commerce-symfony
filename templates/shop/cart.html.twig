{% extends 'base.html.twig' %}

{% block title %}Mon Panier{% endblock %}

{% block body %}
    <h2 class="mb-4">
        <i class="bi bi-cart3 me-2"></i>Mon Panier
    </h2>

    {% if cart.cartItems is empty %}
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Votre panier est vide.
            <a href="{{ path('home') }}" class="alert-link">Continuer mes achats</a>
        </div>
    {% else %}
        <div class="row">
            <div class="col-md-8">
                {% for item in cart.cartItems %}
                    <div class="card shadow-sm mb-3">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-2 text-center">
                                    <i class="bi bi-box-seam" style="font-size:40px;"></i>
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-0">{{ item.product.name }}</h6>
                                    <small class="text-muted">
                                        {{ item.product.category.name }}
                                    </small>
                                </div>
                                <div class="col-md-2 text-center">
                                    <span class="badge bg-secondary">
                                        x{{ item.quantity }}
                                    </span>
                                </div>
                                <div class="col-md-2 fw-bold text-success">
                                    {{ item.total }} €
                                </div>
                                <div class="col-md-2 text-end">
                                    <a href="{{ path('cart_remove', {id: item.product.id}) }}"
                                       class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="mb-3">Résumé de la commande</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Nombre d'articles</span>
                            <span>{{ cart.cartItems|length }}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Livraison</span>
                            <span class="text-success">Gratuite</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total</span>
                            <span>{{ cart.total }} €</span>
                        </div>
                        <a href="{{ path('cart_clear') }}" class="btn btn-outline-danger w-100 mt-3">
                            <i class="bi bi-trash me-1"></i> Vider le panier
                        </a>
                        <a href="#" class="btn btn-dark w-100 mt-2">
                            <i class="bi bi-check-circle me-1"></i> Valider la commande
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}
