{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
    <h2 class="mb-4">Toutes les catégories</h2>
    <div class="row">
        {% for category in categories %}
            <div class="col-md-4 mb-3">
                <a href="{{ path('products_by_category', {id: category.id}) }}"
                   class="text-decoration-none">
                    <div class="card text-center p-4 shadow-sm h-100">
                        <i class="bi bi-tag" style="font-size:40px;"></i>
                        <h4 class="mt-2">{{ category.name }}</h4>
                        <p class="text-muted">
                            {{ category.products|length }} produit(s)
                        </p>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
