{% extends 'base.html.twig' %}

{% block title %}{{ product.name }}{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a href="{{ path('home') }}">Accueil</a>
            </li>
            <li class="breadcrumb-item">
                <a href="{{ path('browse_categories') }}">Catégories</a>
            </li>
            <li class="breadcrumb-item">
                <a href="{{ path('products_by_category', {id: product.category.id}) }}">
                    {{ product.category.name }}
                </a>
            </li>
            <li class="breadcrumb-item active">{{ product.name }}</li>
        </ol>
    </nav>

    <div class="row">
        <div class="col-md-5">
            <div class="bg-light text-center py-5 rounded shadow-sm">
                <i class="bi bi-box-seam" style="font-size:100px; color:#333;"></i>
            </div>
        </div>
        <div class="col-md-7">
            <h2>{{ product.name }}</h2>
            <p class="text-muted">
                <i class="bi bi-tag me-1"></i>
                Catégorie : {{ product.category.name }}
            </p>
            <h3 class="text-success fw-bold">{{ product.price }} €</h3>
            <hr>
            <p>{{ product.description }}</p>

            <form action="{{ path('cart_add', {id: product.id}) }}" method="POST">
                <div class="d-flex gap-2 mt-3">
                    <input type="number" name="quantity" class="form-control w-25"
                           value="1" min="1">
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-cart-plus me-1"></i> Ajouter au panier
                    </button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
