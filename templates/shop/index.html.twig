{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div class="text-center py-5 bg-light rounded mb-4">
        <h1>Bienvenue sur MonShop</h1>
        <p class="lead">Découvrez nos produits et catégories</p>
        <a href="{{ path('browse_categories') }}" class="btn btn-dark btn-lg">
            <i class="bi bi-grid me-1"></i> Voir les catégories
        </a>
    </div>

    <h2 class="mb-4">Nos Produits</h2>
    <div class="row">
        {% for product in products %}
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title">{{ product.name }}</h5>
                        <p class="text-muted small">{{ product.description }}</p>
                        <p class="fw-bold text-success">{{ product.price }} €</p>
                        <a href="{{ path('product_details', {id: product.id}) }}"
                           class="btn btn-dark btn-sm w-100">
                            <i class="bi bi-eye me-1"></i> Voir le produit
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
