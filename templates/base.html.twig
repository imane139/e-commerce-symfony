<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Mon E-commerce{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('home') }}">
                <i class="bi bi-shop me-1"></i> MonShop
            </a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="{{ path('home') }}">Accueil</a>
                <a class="nav-link" href="{{ path('browse_categories') }}">Catégories</a>
                <a class="nav-link" href="{{ path('cart') }}">
                    <i class="bi bi-cart3 me-1"></i>Panier
                </a>

                {% if app.user %}
                    <span class="nav-link text-warning">
                        <i class="bi bi-person-check me-1"></i>
                        Bienvenue, {{ app.user.name }}
                    </span>
                    <a class="nav-link" href="{{ path('profile') }}">
                        <i class="bi bi-person me-1"></i>Profil
                    </a>
                    <a class="nav-link" href="{{ path('logout') }}">
                        <i class="bi bi-box-arrow-right me-1"></i>Déconnexion
                    </a>
                {% else %}
                    <a class="nav-link" href="{{ path('login') }}">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Connexion
                    </a>
                    <a class="nav-link" href="{{ path('register') }}">
                        <i class="bi bi-person-plus me-1"></i>Inscription
                    </a>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        {% block body %}{% endblock %}
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
